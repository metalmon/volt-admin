{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Volt Admin",
  "mainBinaryName": "VoltAdmin",
  "version": "0.1.0",
  "identifier": "ru.metalmon.volt-admin",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Volt Admin",
        "width": 1180,
        "height": 820,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "installer-hooks.nsi",
        "languages": ["Russian", "English"]
      }
    },
    "linux": {
      "deb": {
        "desktopTemplate": "volt-admin.desktop"
      },
      "rpm": {
        "desktopTemplate": "volt-admin.desktop"
      }
    }
  }
}
